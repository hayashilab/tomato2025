            RCLCPP_INFO(this->get_logger(), "\n✅ Planning to home success.\n🟡 NEXT STATE: EXECUTING PLAN (Stage %d)", motion_planning_stage_);
            setState(STATE_EXECUTING_PLAN);
        }
