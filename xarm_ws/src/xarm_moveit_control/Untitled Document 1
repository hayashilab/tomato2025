                                       "/gripper/open",
                                       cb))
        {
            RCLCPP_ERROR(this->get_logger(), "\n❌ Service /gripper/open not available after timeout\n🟡 NEXT STATE: WAITING FOR USER");
            setState(STATE_WAITING_FOR_USER);
        }
    }

