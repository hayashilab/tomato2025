    // === Execute Plan ===
    void executeCurrentPlan()
    {
        RCLCPP_INFO(this->get_logger(),
                    "\n🟢CURRENT STATE: EXECUTING PLAN (Stage %d)\n🔵 In executeCurrentPlan()",
                    motion_planning_stage_);

        if (!plan_success_)
        {
            RCLCPP_ERROR(this->get_logger(), "\n❌ No plan to execute\n🟡 NEXT STATE: CHECK HOME");
            error_flag_ = true;
            publishResult(false);
            setState(STATE_CHECK_HOME);
            return;
        }

        move_group_->setMaxVelocityScalingFactor(default_velocity_scaling_);

        motion_done_ = false; // reset flag before execution

        if (motion_planning_stage_ <= 1)
        {
            RCLCPP_INFO(this->get_logger(),
                        "⚙️ Executing via /xarm/set_servo_angle (joint-space, Stage %d)",
                        motion_planning_stage_);

            const auto &points = current_plan_.trajectory_.joint_trajectory.points;
            if (points.empty())
            {
                RCLCPP_WARN(this->get_logger(), "❌ No trajectory points to execute.");
                error_flag_ = true;
                publishResult(false);
                setState(STATE_CHECK_HOME);
                return;
            }

            const auto &target_positions = points.back().positions;

            auto client = this->create_client<xarm_msgs::srv::MoveJoint>("/xarm/set_servo_angle");
            if (!client->wait_for_service(std::chrono::seconds(10)))
            {
                RCLCPP_ERROR(this->get_logger(), "❌ Service /xarm/set_servo_angle unavailable");
                error_flag_ = true;
                publishResult(false);
                setState(STATE_CHECK_HOME);
                return;
            }

            auto req = std::make_shared<xarm_msgs::srv::MoveJoint::Request>();
            req->angles = std::vector<float>(target_positions.begin(), target_positions.end());
            req->speed  = static_cast<float>(joint_speed_);
            req->acc    = static_cast<float>(joint_acc_);
            req->mvtime = 0.0f;
            req->wait   = false;

            client->async_send_request(req,
                [this](rclcpp::Client<xarm_msgs::srv::MoveJoint>::SharedFuture future)
                {
                    auto resp = future.get();
                    if (resp->ret == 0)
                    {
                        RCLCPP_INFO(this->get_logger(), "✅ Joint motion finished successfully");
                    }
                    else
                    {
                        RCLCPP_WARN(this->get_logger(), "⚠️ Joint motion failed (ret=%d, msg='%s')",
                                    resp->ret, resp->message.c_str());
                    }
                });
        }
        else
        {
            RCLCPP_INFO(this->get_logger(),
                        "⚙️ Executing via /xarm/set_position (Cartesian-space, Stage %d)",
                        motion_planning_stage_);

            geometry_msgs::msg::Pose target_pose = move_group_->getCurrentPose().pose;

            auto client = this->create_client<xarm_msgs::srv::MoveCartesian>("/xarm/set_position");
            if (!client->wait_for_service(std::chrono::seconds(10)))
            {
                RCLCPP_ERROR(this->get_logger(), "❌ Service /xarm/set_position unavailable");
                error_flag_ = true;
                publishResult(false);
                setState(STATE_CHECK_HOME);
                return;
            }

            auto req = std::make_shared<xarm_msgs::srv::MoveCartesian::Request>();
            req->pose = {
                static_cast<float>(target_pose.position.x * 1000.0),
                static_cast<float>(target_pose.position.y * 1000.0),
                static_cast<float>(target_pose.position.z * 1000.0),
                0.0f, 0.0f, 0.0f
            };
            req->speed  = static_cast<float>(cartesian_speed_);
            req->acc    = static_cast<float>(cartesian_acc_);
            req->mvtime = 0.0f;
            req->wait   = false;

            client->async_send_request(req,
                [this](rclcpp::Client<xarm_msgs::srv::MoveCartesian>::SharedFuture future)
                {
                    auto resp = future.get();
                    if (resp->ret == 0)
                    {
                        RCLCPP_INFO(this->get_logger(), "✅ Cartesian motion finished successfully");
                    }
                    else
                    {
                        RCLCPP_WARN(this->get_logger(), "⚠️ Cartesian motion failed (ret=%d, msg='%s')",
                                    resp->ret, resp->message.c_str());
                    }
                });
        }

        RCLCPP_INFO(this->get_logger(), "📨 Motion request sent (waiting for completion)");
    }


    /////////////////////////////////////////////////////////////// CAMERA RELATED //////////////////////////////////////////////
    void clearRealsenseCameraQueue()
    {
        std::lock_guard<std::mutex> lock(camera_queue_mutex_);
        std::queue<geometry_msgs::msg::PoseStamped> empty;
        std::swap(realsense_target_pose_queue_, empty);
        RCLCPP_INFO(this->get_logger(), "\n🟣 Cleared RealSense camera pose queue");
    }

    void clearKinectCameraQueue()
    {
        std::lock_guard<std::mutex> lock(target_queue_mutex_); // ✅ Correct mutex for Kinect
        std::queue<geometry_msgs::msg::PoseStamped> empty;
        std::swap(kinect_target_pose_queue_, empty);
        RCLCPP_INFO(this->get_logger(), "\n🟣 Cleared Azure Kinect camera pose queue");
    }

    void KinectPoseCallback(const geometry_msgs::msg::PoseStamped::SharedPtr msg)
    {
        if (active_camera_ != CAMERA_KINECT)
            return;

        {
            // Scoped block so mutex unlocks early
            std::lock_guard<std::mutex> lock(target_queue_mutex_);
            kinect_target_pose_queue_.push(*msg);
        } // 🔓 unlocks here

        // Update detection timestamp (safe without lock)
        last_kinect_detection_time_ = this->now();
        tomato_detected_recently_ = true;

        if (bunker_moving_)
        {
            RCLCPP_INFO(this->get_logger(), "🍅 Tomato detected → stopping bunker.");
            baseMotion(5); // Stop
            bunker_moving_ = false;
            active_camera_ = CAMERA_KINECT;

            clearKinectCameraQueue();   // ✅ now safe
            setState(STATE_WAITING_FOR_TARGET);
        }
    }


    void RealsensePoseCallback(const geometry_msgs::msg::PoseStamped::SharedPtr msg)
    {
        if (active_camera_ == CAMERA_REALSENSE)
        {
            std::lock_guard<std::mutex> lock(camera_queue_mutex_);
            realsense_target_pose_queue_.push(*msg);

            // RCLCPP_INFO(this->get_logger(),
            //             "Received RealSense target: x=%.3f, y=%.3f, z=%.3f. Queue size: %ld",
            //             msg->pose.position.x, msg->pose.position.y, msg->pose.position.z,
            //             realsense_target_pose_queue_.size());
        }
        else
        {
            RCLCPP_DEBUG(this->get_logger(),
                         "Received RealSense pose but active_camera is not REALSENSE, ignoring");
        }
    }

    void processNextTargetUnified()
    {
        ///////////////////////////////////////////////////// KINECT SECTION /////////////////////////////////////////////////////////
        if (active_camera_ == CAMERA_KINECT)
        {
            std::lock_guard<std::mutex> lock(target_queue_mutex_);

            RCLCPP_INFO(this->get_logger(),
                        "\n🟢 CURRENT STATE: WAITING FOR TARGET"
                        "\n🟣 ACTIVE CAMERA: KINECT"
                        "\n🔵 In processNextTargetUnified()");

            // === Check if any tomato target exists in Kinect queue ===
            if (!kinect_target_pose_queue_.empty())
            {
                RCLCPP_INFO(this->get_logger(), "🎯 Kinect target detected");

                // Get newest target
                kinect_target_ = kinect_target_pose_queue_.front();
                kinect_target_pose_queue_.pop();

                // Apply default forward orientation for grasp
                kinect_target_.pose.orientation = default_orientation_;
                target_contact_pose_ = kinect_target_.pose;

                RCLCPP_INFO(this->get_logger(),
                            "✅ Using Kinect target:\n"
                            "   position [x=%.3f, y=%.3f, z=%.3f]",
                            target_contact_pose_.position.x,
                            target_contact_pose_.position.y,
                            target_contact_pose_.position.z);

                // Proceed to planning motion (Stage 1)
                RCLCPP_INFO(this->get_logger(),
                            "🟡 NEXT STATE: PLANNING MOTION (Stage %d)",
                            motion_planning_stage_);
                setState(STATE_PLANNING_MOTION);
            }
            else
            {
                // === No tomato detected ===
                if (connect_bunker_)
                {
                    RCLCPP_WARN(this->get_logger(),
                                "⏳ No tomato detected and bunker connected → moving bunker...");

                    // Immediately change to bunker state and invoke movement handler
                    setState(STATE_MOVING_BUNKER);
                    handleBunkerMovement(); // Just to ensure
                }
                else
                {
                    RCLCPP_DEBUG(this->get_logger(),
                                 "⚠️ No tomato detected. Bunker disabled → Kinect will keep waiting.");
                }
            }
        }

        /////////////////////////////////////////////////////////// REALSENSE SECTION //////////////////////////////////////////////////
        else if (active_camera_ == CAMERA_REALSENSE)
        {
            RCLCPP_INFO(this->get_logger(),
                        "\n🟢 CURRENT STATE: WAITING FOR TARGET"
                        "\n🟣 ACTIVE CAMERA: REALSENSE"
                        "\n🔵 In processNextTargetUnified()");

            std::lock_guard<std::mutex> lock(camera_queue_mutex_);
            rclcpp::Time now = this->now();

            // ✅ Initialize timer the first time RealSense becomes active
            if (realsense_last_target_time_.nanoseconds() == 0)
                realsense_last_target_time_ = now;

            if (!realsense_target_pose_queue_.empty())
            {
                // 🟢 Target found → reset timer
                realsense_last_target_time_ = now;
                RCLCPP_INFO(this->get_logger(), "🎯 RealSense target detected");

                // Take the most recent RealSense target
                realsense_target_ = realsense_target_pose_queue_.front();
                realsense_target_pose_queue_.pop();

                // Default orientation (no DRL offset yet)
                realsense_target_.pose.orientation = default_orientation_;
                target_contact_pose_ = realsense_target_.pose;

                RCLCPP_INFO(this->get_logger(),
                            "✅ Using RealSense target pose:\n"
                            "   position [x=%.3f, y=%.3f, z=%.3f]",
                            target_contact_pose_.position.x,
                            target_contact_pose_.position.y,
                            target_contact_pose_.position.z);

                // Go directly to grasp stage
                motion_planning_stage_ = 2;
                RCLCPP_INFO(this->get_logger(),
                            "🟡 NEXT STATE: PLANNING MOTION (Stage %d)",
                            motion_planning_stage_);
                setState(STATE_PLANNING_MOTION);
            }
            else
            {
                double elapsed = (now - realsense_last_target_time_).seconds();

                if (elapsed >= 3.0)
                {
                    RCLCPP_WARN(this->get_logger(),
                                "⏳ No RealSense target for %.1f s → returning to CHECK_HOME.", elapsed);
                    realsense_last_target_time_ = now; // reset timer
                    setState(STATE_CHECK_HOME);
                }
                else
                {
                    RCLCPP_DEBUG(this->get_logger(),
                                 "⚠️ No target detected in RealSense queue — waiting (%.1fs elapsed)...", elapsed);
                }
            }
        }

        ////////////////////////////////////////////////////////// SAFETY FALLBACK /////////////////////////////////////////////////////
        else
        {
            RCLCPP_ERROR(this->get_logger(),
                         "❌ Unknown active_camera_ value (%d). Resetting to KINECT.",
                         static_cast<int>(active_camera_));
            active_camera_ = CAMERA_KINECT;
            clearKinectCameraQueue();
            setState(STATE_WAITING_FOR_TARGET);
        }
    }

    ////////////////////////////////////////////////////// GRIPPER CONTROL //////////////////////////////////////////////////////////////
    // === Full grasp pipeline (async version) ===
    void callGripperService()
    {
        RCLCPP_INFO(this->get_logger(), "🟢 CURRENT STATE: GRIPPER CONTROL\n🔵 In callGripperService()");
        RCLCPP_INFO(this->get_logger(), "\nStarting grasp attempt..., current grasp_attempt_count_ = %d", grasp_attempt_count_);
        closeGripperAsync();
        grasp_attempt_count_++;
        RCLCPP_INFO(this->get_logger(), "grasp_attempt_count +1");
    }

    void closeGripperAsync()
    {
        using Service = std_srvs::srv::Empty;
        auto cb = std::bind(&MotionPlanning2PhasesNode::onCloseGripperResponse, this, std::placeholders::_1);

        if (!callServiceAsync<Service>(this,
                                       close_client_,
                                       "/gripper/close",
                                       cb))
        {
            RCLCPP_WARN(this->get_logger(), "\n❌ Service /gripper/close not available after timeout");
            setState(STATE_WAITING_FOR_USER);
        }
    }

